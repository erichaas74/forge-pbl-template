    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@google/model-viewer": "^4.2.0",
    "firebase": "^12.18.0",
    "phaser": "4.2.1",
    "rxjs": "~7.8.0",
    "three": "0.182.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@types/three": "0.182.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "ffmpeg-static": "^5.3.0",
